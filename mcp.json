{
  "mcpServers": {
    "john-bardeen-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "TITAN_PROTOCOL": "BARDEEN",
        "TARGET_CHAIN": "Solana",
        "FIPS_203_LEVEL": "ML-KEM-768",
        "FIPS_204_LEVEL": "ML-DSA-65"
      },
      "tools": [
        {
          "name": "verify_john_bardeen_discovery",
          "description": "Verifies core invariant principles: Co-invented the point-contact transistor; co-developed BCS theory of superconductivity (2 Physics Nobels)",
          "parameters": {
            "type": "object",
            "properties": {
              "input_data": {
                "type": "string"
              },
              "precision_level": {
                "type": "integer"
              }
            },
            "required": [
              "input_data"
            ]
          }
        },
        {
          "name": "model_john_bardeen_telemetry",
          "description": "Models high-assurance domain telemetry for Solid-State & Condensed Matter Physics",
          "parameters": {
            "type": "object",
            "properties": {
              "telemetry_vector": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "telemetry_vector"
            ]
          }
        }
      ]
    }
  }
}